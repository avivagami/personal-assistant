# ---- Telegram ----
# From @BotFather: /newbot
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. Message @userinfobot to get it.
TELEGRAM_OWNER_ID=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Model for the unattended checks (15-minute glance, morning brief, nudges)
ANTHROPIC_MODEL_PROACTIVE=claude-sonnet-5

# ---- Supabase (your own project) ----
SUPABASE_URL=https://xxxx.supabase.co
# Project Settings -> API -> service_role. Server only. Never in a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth (your own Google Cloud project, "Desktop app" client) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Encryption key for OAuth tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Identity the browser uses on booking forms (never your passwords) ----
BOOKING_NAME=Aviv
BOOKING_PHONE=
BOOKING_EMAIL=

# ---- Weather for the morning brief (free, no account needed) ----
WEATHER_LAT=32.0853
WEATHER_LON=34.7818
WEATHER_PLACE=Tel Aviv

# ---- Behaviour ----
TIMEZONE=Asia/Jerusalem
OWNER_NAME=Aviv
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_MINUTES=15
MORNING_BRIEF_TIME=07:30
DROPPED_THREADS_TIME=17:00
# Draft replies for urgent mail during triage (at most three per run)
TRIAGE_AUTODRAFT=true
AUDIT_RETENTION_DAYS=90
CHAT_RETENTION_DAYS=30
APPROVAL_TTL_HOURS=24
