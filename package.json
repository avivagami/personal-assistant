{
  "name": "personal-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "A personal assistant you text on Telegram. Reads Gmail and Calendar live, acts only after a tap of approval, keeps memory in your own Supabase.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:injection": "tsx scripts/injection-test.ts",
    "db:migrate": "tsx scripts/print-migration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@supabase/supabase-js": "^2",
    "dotenv": "^17.4.2",
    "googleapis": "^160",
    "grammy": "^1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
